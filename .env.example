# ================================================
# ROMIKU MEDIA — ENVIRONMENT CONFIGURATION
# ================================================
# Copy this file to .env and configure for your environment
# NEVER commit .env to version control!

# ================================================
# SERVER
# ================================================

# Port to run the server on
PORT=3000

# Environment: development, staging, or production
NODE_ENV=development

# ================================================
# SECURITY
# ================================================

# JWT Secret Key - MUST be at least 32 characters!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CHANGE THIS IN PRODUCTION!
JWT_SECRET=your-super-secure-random-key-min-32-chars-change-me

# Admin Password - MUST be at least 16 characters!
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# CHANGE THIS ON FIRST LOGIN!
ADMIN_PASSWORD=your-secure-admin-password-min-16-chars

# CORS Origin - Restrict to your domain in production
# Format: https://yourdomain.com
# Production: https://romikumedia.com
CORS_ORIGIN=http://localhost:3000

# ================================================
# DATABASE
# ================================================

# Database path
DB_PATH=./data/romiku.db

# For production, uncomment and configure PostgreSQL instead:
# DB_TYPE=postgresql
# DB_HOST=your-postgres-host
# DB_PORT=5432
# DB_NAME=romiku
# DB_USER=postgres
# DB_PASSWORD=your-secure-password

# ================================================
# BACKUP
# ================================================

# Enable automated backups
BACKUP_ENABLED=true

# Backup interval: hourly, daily, weekly
BACKUP_INTERVAL=daily

# Backup destination (local or S3)
# Local: ./data/backups
# S3: s3://your-bucket/backups
BACKUP_DESTINATION=./data/backups

# AWS credentials (if using S3 backups)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ================================================
# LOGGING
# ================================================

# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Log file path
LOG_FILE=./logs/romiku.log

# Sentry error tracking (optional)
# SENTRY_DSN=https://your-sentry-key@sentry.io/project

# ================================================
# RATE LIMITING
# ================================================

# Global rate limit: requests per 15 minutes per IP
RATE_LIMIT_GENERAL=100

# Review submission rate limit: reviews per hour per IP
RATE_LIMIT_REVIEWS=5

# Auth rate limit: login attempts per 15 minutes
RATE_LIMIT_AUTH=5

# ================================================
# EMAIL (Optional - for future features)
# ================================================

# Email provider: smtp, sendgrid, mailgun
# EMAIL_PROVIDER=smtp

# SMTP Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=noreply@romikumedia.com

# SendGrid (alternative)
# SENDGRID_API_KEY=your-sendgrid-key

# ================================================
# ANALYTICS (Optional)
# ================================================

# Google Analytics
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Mixpanel
# MIXPANEL_TOKEN=your-mixpanel-token

# ================================================
# GOOGLE FORMS (Integration)
# ================================================

# Creator Registration Form URL
GOOGLE_FORM_CREATOR=https://docs.google.com/forms/d/e/1FAIpQLScbdwlkWyRUK3icDgmFK753V3mIVrhH6v_I1pqs6Pk-eceROw/viewform?usp=publish-editor

# Brand Registration Form URL
GOOGLE_FORM_BRAND=https://docs.google.com/forms/d/YOUR_FORM_ID/viewform

# ================================================
# THIRD-PARTY SERVICES
# ================================================

# ReCAPTCHA (for form protection)
# RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Stripe (if monetization needed)
# STRIPE_PUBLIC_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...

# ================================================
# FEATURE FLAGS
# ================================================

# Enable review system
FEATURE_REVIEWS=true

# Enable creator registration
FEATURE_CREATOR_REG=true

# Enable brand registration
FEATURE_BRAND_REG=true

# Enable admin panel
FEATURE_ADMIN=true

# ================================================
# ADVANCED
# ================================================

# Trust proxy (if behind reverse proxy)
TRUST_PROXY=1

# Compression level: 0-9 (9 is max compression)
COMPRESSION_LEVEL=6

# Session duration in hours
SESSION_DURATION=8

# Maximum request body size (in MB)
MAX_REQUEST_SIZE=10
